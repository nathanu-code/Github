# Anthropic / Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Higgsfield AI API  (get from https://cloud.higgsfield.ai/api-keys)
# Option A — separate keys
HIGGSFIELD_API_KEY=your_higgsfield_api_key_here
HIGGSFIELD_API_SECRET=your_higgsfield_api_secret_here
# Option B — combined key:secret in single env var
# HF_KEY=your_api_key:your_api_secret

HIGGSFIELD_BASE_URL=https://platform.higgsfield.ai

# Output settings
OUTPUT_DIR=./output
MAX_CONCURRENT_JOBS=3
POLL_INTERVAL_SECONDS=5
